@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix schema1:  <http://schema.org/> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix wgs84:    <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix osm:      <https://www.openstreetmap.org/> .
@prefix monuments:<http://monuments-historiques.fr/resource/> .
@prefix void:     <http://rdfs.org/ns/void#> .


schema1:Place
    a owl:Class ;
    rdfs:label "Place" .


dcterms:modified
    a owl:DatatypeProperty ;
    rdfs:domain schema1:Place ;
    rdfs:range xsd:date ;
    rdfs:label "Date de modification" .

schema1:addressLocality
    a owl:DatatypeProperty ;
    rdfs:domain schema1:Place ;
    rdfs:range xsd:string ;
    rdfs:label "Commune" .

schema1:addressRegion
    a owl:DatatypeProperty ;
    rdfs:domain schema1:Place ;
    rdfs:range xsd:string ;
    rdfs:label "Région" .

schema1:department
    a owl:DatatypeProperty ;
    rdfs:domain schema1:Place ;
    rdfs:range xsd:string ;
    rdfs:label "Département" .

schema1:name
    a owl:DatatypeProperty ;
    rdfs:domain schema1:Place ;
    rdfs:range xsd:string ;
    rdfs:label "Nom" .

wgs84:lat
    a owl:DatatypeProperty ;
    rdfs:domain schema1:Place ;
    rdfs:range xsd:decimal ;
    rdfs:label "Latitude" .

wgs84:long
    a owl:DatatypeProperty ;
    rdfs:domain schema1:Place ;
    rdfs:range xsd:decimal ;
    rdfs:label "Longitude" .

osm:osmId
    a owl:DatatypeProperty ;
    rdfs:domain schema1:Place ;
    rdfs:range xsd:string ;
    rdfs:label "Identifiant OSM" .


schema1:url
    a owl:ObjectProperty ;
    rdfs:domain schema1:Place ;
    rdfs:range xsd:anyURI ;
    rdfs:label "URL" .

